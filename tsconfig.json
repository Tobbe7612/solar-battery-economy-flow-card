{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "sourceMap": true,
    "inlineSources": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src-v2",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src-v2/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}